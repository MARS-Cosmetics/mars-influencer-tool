# Copy to .env.local and fill in real values. Never commit .env or .env.local.

# --- Database / Auth (required) ---
DATABASE_URL=postgresql://user@localhost:5432/mars_influencer
AUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- CreatorX / Influenzer.ai (preferred analytics source) ---
# When both EMAIL and PASSWORD are set, /api/culturex/[handle] and the
# asset refresh endpoint will prefer CreatorX over CultureX and the mock.
CREATORX_BASE_URL=https://server-test-2.influenzer.ai
CREATORX_EMAIL=
CREATORX_PASSWORD=
CREATORX_ACCOUNT_TYPE=agency
# Set to "true" to unlock audience demographics on each profile call.
# This consumes credits on the CreatorX account.
CREATORX_UNLOCK=false

# --- CultureX (optional fallback) ---

# --- Shopify (required in production) ---
# SHOPIFY_STORE_URL=
# SHOPIFY_ACCESS_TOKEN=

