// ============================================================
// 16. SYNC_LOG — Track all Shopify sync operations
// ============================================================

model SyncLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncType       String    @map("sync_type") // products, inventory, orders, tracking
  status         String    @default("running") // running, completed, failed
  triggeredBy    String?   @map("triggered_by") // "cron" or user ID
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  itemsProcessed Int?      @map("items_processed")
  itemsCreated   Int?      @map("items_created")
  itemsUpdated   Int?      @map("items_updated")
  itemsFailed    Int?      @map("items_failed")
  errorMessage   String?   @map("error_message")
  details        Json?

  @@index([syncType])
  @@index([startedAt])
  @@map("sync_logs")
}

// ============================================================
// 17. ACTIVITY_LOG — Audit trail for all actions
// ============================================================

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  entityType  String   @map("entity_type") // collaboration, influencer, etc.
  entityId    String   @map("entity_id") @db.Uuid
  action      String // status_change, field_update, product_added, comment, created, etc.
  field       String? // which field changed (e.g. "status", "agreedAmount")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  description String? // human-readable summary
  changes     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_log")
}

// ============================================================
// DISCOVERY FEATURE — AI-powered creator search + bookmarks
// Tables are used ONLY by src/features/discovery/.
// To remove the feature, delete these models + the discovery
// feature folder + the /api/discovery routes + the /discover page.
// ============================================================

enum BookmarkStatus {
  new
  contacted
  responded
  shortlisted
  declined
  rejected
}

model DiscoveryBookmark {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  campaignId      String         @map("campaign_id") @db.Uuid
  platform        String // "instagram" | "youtube" | "tiktok"
  externalUserId  String         @map("external_user_id") // Influenzer userId
  username        String
  profileSnapshot Json           @map("profile_snapshot") // full profile from Filter API
  note            String?
  status          BookmarkStatus @default(new)
  statusUpdatedAt DateTime?      @map("status_updated_at") @db.Timestamptz()
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user     User     @relation("UserDiscoveryBookmarks", fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, platform, externalUserId])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@map("discovery_bookmarks")
}

model InfluencerSearch {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  campaignId      String   @map("campaign_id") @db.Uuid
  platform        String
  userPrompt      String   @map("user_prompt") @db.Text
  generatedFilter Json     @map("generated_filter") // post-resolution filter sent to Influenzer
  resultCount     Int      @map("result_count")
  creditsBalance  Decimal? @map("credits_balance") @db.Decimal(12, 2) // balance after search
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user     User     @relation("UserInfluencerSearches", fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
  @@map("influencer_searches")
}

// ============================================================
// Influencer Suggestions — inbound suggestions (via Telegram bot, etc.)
// ============================================================

enum SuggestionStatus {
  pending
  approved
  rejected
}

enum SuggestionSource {
  telegram
  manual
}

model InfluencerSuggestion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Who submitted it (outside the system)
  source           SuggestionSource @default(telegram)
  telegramUserId   String?          @map("telegram_user_id")
  telegramUsername String?          @map("telegram_username")
  submittedByName  String?          @map("submitted_by_name")

  // What was submitted
  platform   String // "instagram" | "youtube" | "tiktok"
  profileUrl String  @map("profile_url")
  handle     String? // extracted @handle if parseable
  note       String?

  // Assignment
  assignedToUserId String @map("assigned_to_user_id") @db.Uuid
  assignedTo       User   @relation("UserAssignedSuggestions", fields: [assignedToUserId], references: [id])

  // Review
  status           SuggestionStatus @default(pending)
  reviewerNote     String?          @map("reviewer_note")
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz()
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedBy       User?            @relation("UserReviewedSuggestions", fields: [reviewedByUserId], references: [id])

  // If approved, link to the created Influencer
  promotedInfluencerId String?     @map("promoted_influencer_id") @db.Uuid
  promotedInfluencer   Influencer? @relation("SuggestionPromotedInfluencer", fields: [promotedInfluencerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([assignedToUserId, status])
  @@index([status, createdAt])
  @@index([telegramUserId])
  @@map("influencer_suggestions")
}

// ============================================================
// Telegram Bot Sessions — per-chat conversation state
// ============================================================

enum TelegramSessionState {
  idle
  awaiting_link
  awaiting_assignee
  awaiting_note
}

model TelegramSession {
  chatId String               @id @map("chat_id")
  state  TelegramSessionState @default(idle)

  // Partial data captured during the flow, flushed on completion
  draftPlatform   String? @map("draft_platform")
  draftProfileUrl String? @map("draft_profile_url")
  draftHandle     String? @map("draft_handle")
  draftAssigneeId String? @map("draft_assignee_id") @db.Uuid

  // Identity captured on first /start
  telegramUserId   String? @map("telegram_user_id")
  telegramUsername String? @map("telegram_username")
  firstName        String? @map("first_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("telegram_sessions")
}

// ============================================================
// DOCUMENT STORAGE — KYC docs, contracts, etc. on Cloudflare R2
// ============================================================

enum DocumentStatus {
  active
  superseded
  revoked
  deleted
}

enum DocumentVerificationStatus {
  pending
  verified
  rejected
}

enum DocumentAccessAction {
  view
  download
  denied
  revoked
}

model DocumentRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Polymorphic owner: "agency" | "influencer" | "contract" | "invoice" | etc.
  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid

  // Document classification: "aadhar" | "pan" | "gst" | "udhyam" | "roster" | "bank_proof" | "other"
  documentType String @map("document_type")

  // Storage
  bucket     String
  storageKey String @unique @map("storage_key")

  // Metadata captured at upload
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  sizeBytes        Int    @default(0) @map("size_bytes")

  // Audit
  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  // Lifecycle
  status       DocumentStatus @default(active)
  supersededBy String?        @map("superseded_by") @db.Uuid
  supersededAt DateTime?      @map("superseded_at") @db.Timestamptz()
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz()
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz()
  revokedBy    String?        @map("revoked_by") @db.Uuid
  revokeReason String?        @map("revoke_reason")

  // KYC verification workflow
  verificationStatus DocumentVerificationStatus @default(pending) @map("verification_status")
  verifiedBy         String?                    @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz()
  rejectionReason    String?                    @map("rejection_reason")

  // Audit log relation
  accessLogs DocumentAccessLog[]

  @@index([entityType, entityId, documentType, status])
  @@index([uploadedBy])
  @@index([status])
  @@map("document_records")
}

// ============================================================
// RATE LIMITING — fixed-window bucket per key (IP, userId, etc.)
// ============================================================

model RateLimitBucket {
  key     String   @id // "ip:1.2.3.4:onboarding" or "user:abc:presign"
  count   Int      @default(0)
  resetAt DateTime @map("reset_at") @db.Timestamptz()

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model DocumentAccessLog {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String               @map("document_id") @db.Uuid
  userId     String?              @map("user_id") @db.Uuid
  action     DocumentAccessAction
  ipAddress  String?              @map("ip_address")
  userAgent  String?              @map("user_agent")
  accessedAt DateTime             @default(now()) @map("accessed_at") @db.Timestamptz()

  document DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, accessedAt])
  @@index([userId, accessedAt])
  @@map("document_access_log")
}
