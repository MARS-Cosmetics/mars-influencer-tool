  udhyamCertificateUrl String? @map("udhyam_certificate_url")
  agencyRosterUrl      String? @map("agency_roster_url")
  aadharDocumentUrl    String? @map("aadhar_document_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  influencers    Influencer[]
  collaborations Collaboration[]
  payments       Payment[]

  @@map("agencies")
}

// ============================================================
// 15. PAYMENT_TERMS — Reusable payment term templates
// ============================================================

model PaymentTerm {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique // e.g., "100% Advance", "50-50 Split", "Net 30"
  description String?

  // Installment breakdown as JSON array
  // e.g., [{"percentage": 50, "trigger": "on_confirmation", "label": "Advance"},
  //        {"percentage": 50, "trigger": "on_content_approval", "label": "On Approval"}]
  installments Json

  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  collaborations Collaboration[]

  @@map("payment_terms")
}

// ============================================================
// 16. CONTENT_IDEAS — Content ideas and themes for campaigns
// ============================================================

model ContentIdea {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Core
  title       String
  description String?
  theme       ContentTheme @default(other)
  platform    Platform?
  contentType ContentType? @map("content_type")

  // Status & Priority
  status   ContentIdeaStatus    @default(idea)
  priority ContentIdeaPriority? @default(medium)

  // Relations
  brandId         String? @map("brand_id") @db.Uuid
  campaignId      String? @map("campaign_id") @db.Uuid
  collaborationId String? @map("collaboration_id") @db.Uuid
  influencerId    String? @map("influencer_id") @db.Uuid

  // Reference material
  referenceUrls String[] @map("reference_urls")
  moodboardUrl  String?  @map("moodboard_url")
  notes         String?

  // Timeline
  targetDate DateTime? @map("target_date") @db.Date

  // Audit
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy String?  @map("created_by") @db.Uuid

  // Relations
  brand         Brand?         @relation(fields: [brandId], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  collaboration Collaboration? @relation(fields: [collaborationId], references: [id])
  influencer    Influencer?    @relation(fields: [influencerId], references: [id])
